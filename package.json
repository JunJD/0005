{
  "name": "jingchu-ar-cross-screen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @jingchu/web dev",
    "dev:server": "pnpm --filter @jingchu/server dev",
    "build": "pnpm -r build",
    "figma:export": "node scripts/export-figma-assets.mjs",
    "figma:import-local": "node scripts/import-local-fig-assets.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@10.33.0"
}
